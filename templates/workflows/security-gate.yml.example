# Copy to .github/workflows/security-gate.yml and customize only after reviewing the VCES security policy.
name: Security Automation Gate

on:
  pull_request:
  push:
    branches: [main]

permissions: {}

jobs:
  workflow-security:
    name: GitHub Actions security analysis
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Analyze GitHub Actions workflows with zizmor
        uses: zizmorcore/zizmor-action@53290badfa369cb0bf7ad16342cb62c2fa47ac7b # v0.8.0
        with:
          advanced-security: false
          annotations: true
          version: v1.31.1

  security-gate:
    name: Security Automation Gate
    needs: workflow-security
    if: always()
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Fail if workflow security analysis did not pass
        if: ${{ needs.workflow-security.result != 'success' }}
        run: |
          echo "Workflow security analysis did not succeed; blocking the security gate."
          exit 1
      - name: Checkout repository
        if: ${{ needs.workflow-security.result == 'success' }}
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Scan source, dependencies, secrets, and infrastructure configuration
        if: ${{ needs.workflow-security.result == 'success' }}
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: fs
          scan-ref: .
          scanners: vuln,misconfig,secret
          severity: CRITICAL,HIGH
          ignore-unfixed: false
          exit-code: "1"
          format: table
          version: v0.76.2
